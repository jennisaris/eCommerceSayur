# Application Environment
APP_ENV=development
APP_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=super-secret-ecommerce-jwt-token-key-2026
JWT_EXPIRATION_HOURS=72

# Midtrans Payment Gateway (Sandbox Default)
MIDTRANS_SERVER_KEY=SB-Mid-server-TEST-KEY-SAMPLE
MIDTRANS_CLIENT_KEY=SB-Mid-client-TEST-KEY-SAMPLE
MIDTRANS_IS_PRODUCTION=false

# Client Configuration
CLIENT_BASE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
