# ==============================================================================
# eCommerce Configuration (Development & Production Template)
# ==============================================================================

# Application Environment: 'development' or 'production'
# In production, default weak secrets are automatically rejected at startup.
APP_ENV=development
APP_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Seeder Control (Set false in production to prevent seeding demo accounts)
RUN_SEEDER=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password_here
DB_NAME=ecommerce_db
DB_SSLMODE=disable

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here

# JWT Authentication Configuration
# CRITICAL: In production, generate a random secret with at least 32 characters!
JWT_SECRET=generate-a-strong-random-secret-key-at-least-32-characters-2026
JWT_EXPIRATION_HOURS=72

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-TEST-KEY-SAMPLE
MIDTRANS_CLIENT_KEY=SB-Mid-client-TEST-KEY-SAMPLE
MIDTRANS_IS_PRODUCTION=false

# Client & CORS Configuration
CLIENT_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

