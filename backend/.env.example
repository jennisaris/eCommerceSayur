COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

MIDTRANS_SERVER_KEY=SB-Mid-server-TEST-KEY-SAMPLE
MIDTRANS_CLIENT_KEY=SB-Mid-client-TEST-KEY-SAMPLE
MIDTRANS_IS_PRODUCTION=false

CLIENT_BASE_URL=http://localhost:3000
